# ==============================================================================
# General Application Settings
# ==============================================================================
PROJECT_NAME="Forensic Handwriting Decision Support System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="change-this-to-a-super-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# Rate Limiting & Background Task Infrastructure
# ==============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_PIPELINE_MAX_REQUESTS=10
RATE_LIMIT_PIPELINE_WINDOW_SEC=60
REDIS_URL="redis://localhost:6379/0"
JOB_STATE_BACKEND="memory"  # "memory" or "redis"
TASK_QUEUE_MAX_RETRIES=3
SIGNATURE_PROVIDER="mock"   # "mock" or "pkcs11"
TIMESTAMP_PROVIDER="mock"   # "mock" or "rfc3161"

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forensic_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ==============================================================================
# Security & CORS
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==============================================================================
# Computer Vision & ML Pipeline Paths
# ==============================================================================
DATASET_ROOT_PATH="./datasets"
MODEL_STORAGE_PATH="./artifacts/models"
EXPLAINABILITY_REPORTS_PATH="./reports"
DEVICE="cuda" # "cuda" or "cpu"
BATCH_SIZE=32

# ==============================================================================
# Audit & Explainability Settings
# ==============================================================================
AUDIT_LOG_ENABLED=True
AUDIT_LOG_PATH="./artifacts/logs/audit.jsonl"
LOG_LEVEL="INFO"
